# SEC asks every client to identify itself with a name and contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your.email@example.com"

DATABASE_URL=postgresql://filings:filings@localhost:5432/filings

# LLM provider: "anthropic" (default) or "fake" (offline, for tests/demos).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Embeddings: "local" (sentence-transformers, no key) or "hash" (offline, tests only).
EMBEDDINGS=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
